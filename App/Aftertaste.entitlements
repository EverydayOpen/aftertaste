<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately empty. Aftertaste is not sandboxed (a sandboxed app cannot see other apps' leftovers) and needs no
	     entitlement: it lists folders in the user's Library and moves chosen items to the Trash, nothing else. -->
</dict>
</plist>
