{
  "name": "bundle-id-with-glob",
  "note": "A bundle ID containing a glob character is refused outright, so a literal name match can never turn into a pattern.",
  "kind": "app",
  "target": "com.example.*",
  "apps": [
    {"id": "com.example.*", "name": "Wild Thing"}
  ],
  "library": {
    "Library/Caches": ["com.example.*", "com.example.other", "com.example.real"],
    "Library/Preferences": ["com.example.*.plist", "com.example.real.plist"],
    "Library/Application Support": ["Wild Thing", "com.example.real"]
  },
  "expect": {
    "emptyResult": true,
    "installedOwned": ["Library/Caches/com.example.other", "Library/Caches/com.example.real", "Library/Preferences/com.example.real.plist"]
  }
}
